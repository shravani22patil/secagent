# ---- Scanning --------------------------------------------------------------
# mock = built-in demo fixtures, NO packets sent (results are labelled "mock_fixture")
# live = run real nmap (results are labelled "live_nmap")
SECAGENT_TOOL_MODE=mock
# Live scans are refused unless the target is private/loopback AND inside this list.
# Comma-separated (or a JSON list). Example for your own lab: 127.0.0.1/32,192.168.1.0/24
SECAGENT_ALLOWED_CIDRS=127.0.0.1/32
SECAGENT_TOOL_TIMEOUT_S=60
SECAGENT_MAX_PORTS=2000
# Leave blank to use PATH / the default Windows install folder.
SECAGENT_NMAP_PATH=
# Set true if the target blocks ping and nmap wrongly reports it as down (-Pn).
SECAGENT_NMAP_SKIP_HOST_DISCOVERY=false

# ---- Optional LLM agents (scans work fully without these) -------------------
SECAGENT_AGENTS_ENABLED=true
SECAGENT_LLM_MODEL=anthropic/claude-sonnet-5-5
# Or use the standard ANTHROPIC_API_KEY variable. Never commit a real key.
SECAGENT_LLM_API_KEY=
SECAGENT_AGENT_MAX_ITER=8

# ---- Service ---------------------------------------------------------------
SECAGENT_SCAN_TIMEOUT_S=180
SECAGENT_SCAN_MAX_ATTEMPTS=2
SECAGENT_MAX_CONCURRENT_SCANS=4
SECAGENT_LOG_LEVEL=INFO
